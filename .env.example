# Provedor padrão de LLM: deepseek | groq | lmstudio | openai | gemini
MANKI_PROVIDER=deepseek

# Chave do provedor escolhido (apenas a que você for usar)
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Overrides opcionais
# MANKI_MODEL=deepseek-flash
# MANKI_BASE_URL=http://localhost:1234/v1
# MANKI_DECK_NAME=Mandarim
# MANKI_OUTPUT=flashcards.apkg
# MANKI_WORKERS=4
# MANKI_TIMEOUT=20
# MANKI_LOG_LEVEL=INFO
